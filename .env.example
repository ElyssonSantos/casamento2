# ====================================
# CASAMENTO2 — VARIÁVEIS DE AMBIENTE
# ====================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env no repositório!

# Porta do servidor backend
PORT=3001

# URL de conexão Redis (Vercel KV, Upstash, ou Redis Cloud)
# Exemplo: redis://default:SUA_SENHA@host:porta
REDIS_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Senha do Admin (hash bcrypt gerado com: npx bcrypt-cli hash 'suasenha')
# Gere o hash com: node -e "import('bcryptjs').then(b=>b.default.hash('suasenha',12).then(console.log))"
ADMIN_PASSWORD_HASH=

# Secret para assinar tokens JWT do admin
ADMIN_JWT_SECRET=mude-este-segredo-para-algo-aleatorio-e-longo

# Domínio permitido no CORS (ex: https://seusite.vercel.app)
ALLOWED_ORIGIN=*
